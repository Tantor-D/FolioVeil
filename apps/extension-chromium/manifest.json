{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "description": "__MSG_appDescription__",
  "version": "1.0.0",
  "default_locale": "en",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "debugger"
  ],
  "host_permissions": [
    "https://weread.qq.com/web/reader/*",
    "https://res.weread.qq.com/*",
    "https://wrco-40036.sh.gfp.tencent-cloud.com/*",
    "https://fanqienovel.com/reader/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "__MSG_appName__",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "commands": {
    "toggle-privacy": {
      "suggested_key": {
        "default": "Alt+Shift+P",
        "mac": "MacCtrl+Shift+P"
      },
      "description": "__MSG_commandTogglePrivacy__"
    },
    "toggle-controls": {
      "suggested_key": {
        "default": "Alt+Shift+O",
        "mac": "MacCtrl+Shift+O"
      },
      "description": "__MSG_commandToggleControls__"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://weread.qq.com/web/reader/*",
        "https://fanqienovel.com/reader/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
